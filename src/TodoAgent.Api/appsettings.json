{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Llm": {
    "Provider": "anthropic",
    "Anthropic": {
      "Model": "claude-opus-5",
      "BaseUrl": "https://api.anthropic.com",
      "MaxTokens": 8192,
      "Effort": "low"
    }
  },
  "Agent": {
    "MaxIterations": 8,
    "RequestTimeoutSeconds": 120
  },
  "Tools": {
    "Provider": "inprocess"
  },
  "Mcp": {
    "Servers": [
      { "Name": "todos", "Url": "http://localhost:5080/mcp" }
    ]
  }
}
